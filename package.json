{
  "name": "taskflow-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @taskflow/web",
    "dev": "npm run dev -w @taskflow/web",
    "typecheck": "npm run typecheck -w @taskflow/web",
    "worker": "npm run worker -w @taskflow/web",
    "db:generate": "npm run generate -w @taskflow/db",
    "db:migrate": "npm run migrate -w @taskflow/db",
    "db:push": "npm run push -w @taskflow/db",
    "db:seed": "npm run seed -w @taskflow/db",
    "check:conflicts": "node scripts/validate-no-conflict-markers.mjs",
    "test:critical-flows": "node scripts/test-critical-flows.mjs"
  }
}
